# ==================== 数据库配置 ====================
POSTGRES_USER=elderly_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=elderly_care

# SQLAlchemy 数据库 URL
# Set this in your deployment environment. Do not commit real credentials.
DATABASE_URL=

# ==================== FastAPI 配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=False
LOG_LEVEL=INFO

# ==================== 安全配置 ====================
# ✅ 修复 P0: 强制从环境变量加载密钥，不再有默认值！
# 生成方式: python -c "import secrets; import base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=your_extremely_random_secret_key_min_32_chars_CHANGE_IN_PRODUCTION
API_KEY=your_random_api_key_min_32_chars_CHANGE_IN_PRODUCTION

# ==================== Home Assistant 集成 ====================
# Home Assistant 地址（如果从 HA 推送事件）
HOME_ASSISTANT_WEBHOOK_ID=elderly_care_webhook
HOME_ASSISTANT_WEBHOOK_SECRET=your_webhook_secret

# ==================== 告警通知配置 ====================
# Email 通知
ALERT_EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_app_password
SMTP_FROM=SafeHome <your_email@gmail.com>

# Mailgun HTTPS API email sending (preferred for production when set)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=SafeHome <support@example.com>
INTERNAL_NOTIFICATION_EMAIL=team@example.com

# 钉钉集成 (可选)
DINGDING_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your_token

# 企业微信集成 (可选)
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key

# ==================== 告警规则阈值 ====================
# 长时间无活动（分钟）
INACTIVITY_THRESHOLD_MINUTES=240

# 卫生间停留过久（分钟）
BATHROOM_TIMEOUT_MINUTES=30

# 起床时间变化（小时）
WAKE_TIME_VARIANCE_HOURS=2

# 夜间活动频次
NIGHT_ACTIVITY_THRESHOLD=5

# 房间活动偏离度 (%)
ROOM_ACTIVITY_DEVIATION_PERCENT=50

# ==================== 数据保留 ====================
# 事件数据保留时间（天）
EVENT_RETENTION_DAYS=180

# ==================== 监控和日志 ====================
ENABLE_PROMETHEUS=True
ENABLE_SENTRY=False
SENTRY_DSN=

# ==================== 开发环境 ====================
TESTING=False

# ==================== 前端 URL 配置 ====================
# 开发环境
# ALLOW_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
# FRONTEND_BASE_URL=http://localhost:3000

# 生产环境
ALLOW_ORIGINS=["https://safehome-frontend.vercel.app", "https://www.linkrytech.com"]
FRONTEND_BASE_URL=https://safehome.linkrytech.com
